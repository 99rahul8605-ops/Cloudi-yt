# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_from_BotFather
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_from_my_telegram_org

# ── Optional: Proxy (recommended on Render to bypass bot-detection) ───────────
# YTDL_PROXY=http://user:pass@host:port

# ── Optional: YouTube cookies (paste full cookies.txt content) ────────────────
# Needed for: age-restricted videos, private videos, some region-locked content
# How to get: install "Get cookies.txt LOCALLY" extension, export from youtube.com
# YOUTUBE_COOKIES=<paste entire cookies.txt here>

# ── Optional: Instagram cookies ───────────────────────────────────────────────
# Needed for: private accounts, stories, some reels
# How to get: export cookies from instagram.com while logged in
# IG_COOKIES=<paste entire cookies.txt here>

# ── Optional: Facebook cookies ────────────────────────────────────────────────
# Needed for: private groups, FB Watch content, some reels
# How to get: export cookies from facebook.com while logged in
# FB_COOKIES=<paste entire cookies.txt here>
